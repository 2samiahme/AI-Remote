# Multi-Provider AI Configuration for AI PDF Chat Assistant
# You can provide one or more API keys. If multiple are provided,
# the assistant uses automatic failover redundancy (Grok -> OpenAI -> Anthropic -> Gemini -> Chrome On-Device).

# 1. Grok AI (xAI)
VITE_GROK_API_KEY=
# VITE_GROK_API_URL=https://api.x.ai/v1/chat/completions
# VITE_GROK_MODEL=grok-beta

# 2. OpenAI
VITE_OPENAI_API_KEY=
# VITE_OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# VITE_OPENAI_MODEL=gpt-4o-mini

# 3. Anthropic (Claude)
VITE_ANTHROPIC_API_KEY=
# VITE_ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
# VITE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 4. Google Gemini API
VITE_GEMINI_API_KEY=
# VITE_GEMINI_MODEL=gemini-1.5-flash

# 5. (Optional) Custom external PDF text extraction endpoint
# If omitted, PDF parsing runs 100% in-browser client-side via PDF.js
# VITE_PDF_EXTRACT_API_URL=
